  "events": [
    {
      "id": "e_frame",
      "type": "ordinary",
      "label": "Elderly last-mortal Nemo interviewed before universal rebirth",
      "description": "In 2092, Nemo Nobody - the last mortal human alive, 118 years old - is interviewed as the stars ship out for a new home, and he remembers lives that may never have happened.",
      "at": {
        "worldRef": "w_frame",
        "timeLabel": "2092"
      },
      "agents": [
        "nemo"
      ]
    },
    {
      "id": "e_station",
      "type": "branch_fork",
      "label": "Childhood station: choose mother or father",
      "description": "It begins at a train station in his childhood, when the train pulls away and Nemo must choose: run after his mother, or stay with his father.",
      "at": {
        "worldRef": "w_frame",
        "timeLabel": "childhood"
      },
      "agents": [
        "nemo_child",
        "mom",
        "dad"
      ]
    },
    {
      "id": "e_mom_path",
      "type": "ordinary",
      "label": "Life path with mother begins",
      "description": "The life where he chose his mother - and the boy who never stopped wondering about the father left behind.",
      "at": {
        "worldRef": "w_mom",
        "timeLabel": "youth"
      },
      "agents": [
        "nemo_child",
        "mom"
      ]
    },
    {
      "id": "e_dad_path",
      "type": "ordinary",
      "label": "Life path with father begins",
      "description": "The life where he stayed - a different childhood, a different sorrow, the same unanswered question in reverse.",
      "at": {
        "worldRef": "w_dad",
        "timeLabel": "youth"
      },
      "agents": [
        "nemo_child",
        "dad"
      ]
    },
    {
      "id": "e_anna_life",
      "type": "ordinary",
      "label": "Possible adulthood with Anna (missed reunions, pool)",
      "description": "The life with Anna - the girl he loved as a teenager; in some versions they find each other again, in others he watches her from a distance his whole life.",
      "at": {
        "worldRef": "w_anna",
        "timeLabel": "adulthood"
      },
      "agents": [
        "nemo",
        "anna"
      ]
    },
    {
      "id": "e_elise_life",
      "type": "ordinary",
      "label": "Possible adulthood with Elise (depression, accidents)",
      "description": "The life with Elise - loving a woman broken by depression; marriage, children, and the accident that leaves him visiting her in a care home.",
      "at": {
        "worldRef": "w_elise",
        "timeLabel": "adulthood"
      },
      "agents": [
        "nemo",
        "elise"
      ]
    },
    {
      "id": "e_jean_life",
      "type": "ordinary",
      "label": "Possible adulthood with Jean (loveless wealth)",
      "description": "The life with Jean - money, order, a beautiful house, and the slow realisation that he does not love her.",
      "at": {
        "worldRef": "w_jean",
        "timeLabel": "adulthood"
      },
      "agents": [
        "nemo",
        "jean"
      ]
    },
    {
      "id": "e_mars",
      "type": "ordinary",
      "label": "Mars / disaster variants across branches",
      "description": "Other versions reach further: journeys to Mars, disasters, deaths - the possibility space of a biography branching past all telling.",
      "at": {
        "worldRef": "w_elise",
        "timeLabel": "midlife"
      },
      "agents": [
        "nemo"
      ]
    },
    {
      "id": "e_observer",
      "type": "observation",
      "label": "Framing: every unlived path exists in possibility space",
      "description": "The film's conceit is that all of these lives exist - every path a life might take, lived somewhere by someone who is still the same man.",
      "at": {
        "worldRef": "w_frame",
        "timeLabel": "interview"
      },
      "agents": [
        "nemo"
      ],
      "payload": {
        "perceptionMode": "many_worlds_recount",
        "observerContinuity": true
      }
    },
    {
      "id": "e_choice_thesis",
      "type": "reveal",
      "label": "Argument that every choice forks a lived biography",
      "description": "The argument underneath: choice is the illusion of one road - every decision forks a whole biography, and the man remembers them all.",
      "at": {
        "worldRef": "w_frame",
        "timeLabel": "climax talk"
      },
      "agents": [
        "nemo"
      ]
    },
    {
      "id": "e_rebirth",
      "type": "ordinary",
      "label": "Universal rebirth approaches; last mortal recounts",
      "description": "As the last mortal, Nemo's death approaches with the Earth's - and with the colonists gone, the universe itself prepares to begin again.",
      "at": {
        "worldRef": "w_frame",
        "timeLabel": "2092 end"
      },
      "agents": [
        "nemo"
      ]
    },
