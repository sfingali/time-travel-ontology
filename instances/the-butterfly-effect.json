    },
    {
      "id": "e_fix1",
      "type": "intervention",
      "label": "First childhood fix attempt",
      "description": "Evan tries to repair the worst day of childhood - the day his friend Kayleigh's life was ruined - by changing what he did then.",
      "at": {
        "worldRef": "w_base",
        "timeLabel": "past"
      },
      "agents": [
        "evan",
        "kayleigh"
      ]
    },
    {
      "id": "e_wake_prison",
      "type": "arrival",
      "label": "Wake into prison timeline",
      "description": "He surfaces in a present where that fix made everything worse: imprisoned, feared, his friend destroyed in a new way.",
      "at": {
        "worldRef": "w_prison",
        "timeLabel": "adult"
      },
      "agents": [
        "evan"
      ]
    },
    {
      "id": "e_fix2",
      "type": "intervention",
      "label": "Further journal rewrites cascade",
      "description": "Each rewrite aims at a smaller, safer correction - and each lands him in a present more damaged than the last.",
      "at": {
        "worldRef": "w_prison",
        "timeLabel": "past"
      },
      "agents": [
        "evan"
      ]
    },
    {
      "id": "e_wake_amp",
      "type": "arrival",
      "label": "Wake into amputee / frat timeline",
      "description": "One attempt costs him both arms in the new present: hospitalised, dependent, his life's work gone.",
      "at": {
        "worldRef": "w_amputee",
        "timeLabel": "adult"
      },
      "agents": [
        "evan",
        "kayleigh"
      ]
    },
    {
      "id": "e_final",
      "type": "intervention",
      "label": "In utero: strangle self with cord",
