        "worldRef": "w_base",
        "timeLabel": "childhood"
      },
      "agents": [
        "evan",
        "kayleigh",
        "tommy"
      ]
    },
    {
      "id": "e_read",
      "type": "departure",
      "label": "College Evan reads journals → body past",
      "description": "Years later, reading his old journals throws Evan back into those lost moments, inside his childhood body, able to act.",
