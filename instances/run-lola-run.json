        "worldRef": "w_call",
        "timeLabel": "t0"
      },
      "agents": [
        "lola"
      ]
    },
    {
      "id": "e_run1_father",
      "type": "ordinary",
      "label": "Father refuses / bank confrontation run1",
      "description": "Lola runs to her father's bank for money; he refuses her, and the confrontation spirals into a robbery - the run ending with a police shot.",
      "at": {
        "worldRef": "w_call",
        "timeLabel": "mid1"
      },
      "agents": [
        "lola",
        "father"
      ]
    },
    {
      "id": "e_run1_market",
      "type": "ordinary",
      "label": "Butterfly collisions (mailman etc.)",
      "description": "On her run, small collisions - a dog on a stair, a passing courier - set strangers' lives on new courses; the film follows them in flashes.",
      "at": {
        "worldRef": "w_call",
        "timeLabel": "street1"
      },
      "agents": [
        "lola",
        "mailman"
      ]
    },
