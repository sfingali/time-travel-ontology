  "events": [
    {
      "id": "e_garage",
      "type": "ordinary",
      "label": "Garage engineering / error-correcting box",
      "description": "Four engineers spend nights and weekends building side projects in a garage - among them a device, the Box, that was meant to cancel gravity fields.",
      "at": {
        "worldRef": "w_prime",
        "timeLabel": "week 0"
      },
      "agents": [
        "abe",
        "aaron"
      ]
    },
    {
      "id": "e_box_found",
      "type": "reveal",
      "label": "Box enables time displacement",
      "description": "A failsafe in the Box's error-correcting loop starts behaving impossibly - and Abe and Aaron discover the field inside it loops time: an object can sit in it for hours and emerge at the moment it entered.",
      "at": {
        "worldRef": "w_prime",
        "timeLabel": "discovery"
      },
      "agents": [
        "abe",
        "aaron"
      ],
      "payload": {
        "travelMode": "box",
        "boxId": "box_mk1"
      }
    },
    {
      "id": "e_abe_hotel",
      "type": "departure",
      "label": "Abe's first controlled hotel start",
      "description": "Abe secretly builds a big enough Box, turns it on in a storage unit, checks into a hotel, and waits - planning to step into the field at noon and walk out when it started.",
      "at": {
        "worldRef": "w_prime",
        "timeLabel": "hotel T0"
      },
      "agents": [
        "abe"
      ],
      "payload": {
        "travelMode": "box",
        "boxId": "abe_box",
        "boxDuration": "~6h",
        "failsafeId": "abe_failsafe"
      }
    },
    {
      "id": "e_abe_exit",
      "type": "arrival",
      "label": "Abe exits box earlier same day",
      "description": "It works: Abe exits a second Box that has been running since morning, emerging into a day where his earlier self is still out there living it.",
      "at": {
        "worldRef": "w_ab1",
        "timeLabel": "hotel T-delta"
      },
      "agents": [
        "abe_box"
      ],
      "payload": {
        "travelMode": "box",
        "boxId": "abe_box"
      }
    },
    {
      "id": "e_stocks",
      "type": "intervention",
      "label": "Stock trades via foreknowledge",
      "description": "The two start using the loops for money - trading stocks with knowledge of the day's closes, then sleeping through the hours they already lived.",
      "at": {
        "worldRef": "w_overlap",
        "timeLabel": "market days"
      },
      "agents": [
        "abe",
        "aaron"
      ],
      "payload": {
        "boxId": "shared"
      }
    },
    {
      "id": "e_recordings",
      "type": "observation",
      "label": "Earpiece recordings guide revisions",
      "description": "Aaron goes further, recording the day's conversations and wearing an earpiece inside the repeat - feeding himself his own lines so he can play every scene perfectly.",
      "at": {
        "worldRef": "w_overlap",
        "timeLabel": "overlap weeks"
      },
      "agents": [
        "aaron_rec"
      ],
      "payload": {
        "note": "Pre-scripted conversations"
      }
    },
    {
      "id": "e_party",
      "type": "intervention",
      "label": "Party / Rachel revisions via recursive boxes",
      "description": "At a birthday party, a guest is shot - and Aaron uses nested Boxes to go back again and again, replaying the afternoon until he engineers a version where no one dies.",
      "at": {
        "worldRef": "w_overlap",
        "timeLabel": "party night"
      },
      "agents": [
        "aaron_rec",
        "rachel"
      ],
      "payload": {
        "boxId": "aaron_box"
      }
    },
    {
      "id": "e_granger",
      "type": "arrival",
      "label": "Thomas Granger appears from downstream",
      "description": "Thomas Granger - the investor backing them - appears in their lives impossibly early, half-conscious and mute: a man who has been inside a Box far longer than any of them can account for.",
      "at": {
        "worldRef": "w_overlap",
        "timeLabel": "unexpected"
      },
      "agents": [
        "granger"
      ],
      "payload": {
        "travelMode": "box",
        "note": "Comatose; provenance tangled"
      }
    },
    {
      "id": "e_failsafe_act",
      "type": "branch_fork",
      "label": "Aaron activates failsafe preemption",
      "description": "Aaron reveals he secretly activated his failsafe Box days earlier - he has been living days that the others don't remember, rewinding further than anyone knew.",
      "at": {
        "worldRef": "w_failsafe",
        "timeLabel": "preempt"
      },
      "agents": [
        "aaron_failsafe"
      ],
      "payload": {
        "failsafeId": "aaron_failsafe",
        "boxId": "failsafe_box",
        "travelMode": "box"
      }
    },
    {
      "id": "e_drugged",
      "type": "intervention",
      "label": "Drugged doubles / hanging-out containment",
      "description": "To keep the day's earlier doubles out of the way, the two drug their own past selves - the story's queasy mark of how far they'll go to control their repeats.",
      "at": {
        "worldRef": "w_failsafe",
        "timeLabel": "gas / attic"
      },
      "agents": [
        "aaron_failsafe",
        "aaron_rec",
        "abe"
      ]
    },
    {
      "id": "e_confront",
      "type": "reveal",
      "label": "Abe confronts overlapping Aarons; trust breaks",
      "description": "Aaron and Abe finally confront each other's hidden repeats - each discovering how many of the days they trusted were already second-hand - and the partnership breaks.",
      "at": {
        "worldRef": "w_failsafe",
        "timeLabel": "airport hangar"
      },
      "agents": [
        "abe",
        "aaron",
        "aaron_failsafe"
      ]
    },
    {
      "id": "e_abe_plan",
      "type": "intervention",
      "label": "Abe tries to shut down further misuse",
      "description": "Abe tries to contain the damage: shut the Boxes down, undo what can be undone, stop the technology before it swallows them.",
      "at": {
        "worldRef": "w_abe_reset",
        "timeLabel": "containment"
