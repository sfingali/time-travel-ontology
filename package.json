{
  "name": "time-travel-ontology",
  "version": "1.0.0",
  "description": "Machine-checkable TypeScript + Zod ontology for time-travel and multiverse narrative encodings",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc && node dist/export-json-schema.js",
    "export-schema": "tsc && node dist/export-json-schema.js",
    "validate": "tsc && node dist/validate.js",
    "test": "tsc && node --test dist/tests/*.js",
    "import": "node scripts/import-archive.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": ["ontology", "time-travel", "multiverse", "zod", "narrative"],
  "license": "MIT",
  "dependencies": {
    "yaml": "^2.5.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2",
    "zod-to-json-schema": "^3.24.5"
  }
}
